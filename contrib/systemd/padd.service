# padd: macropad daemon (layer 3). User unit.
# Install: cp contrib/systemd/padd.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now padd
[Unit]
Description=Framework 16 RGB Macropad daemon (padd)
Documentation=https://github.com/golgor/fw16-macropad/blob/main/docs/adr/0004-layer-3-daemon-and-claims.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/padd
Restart=on-failure
RestartSec=2
# padd needs $XDG_RUNTIME_DIR (its socket) and the device nodes (uaccess via
# udev); nothing else is written. No ProtectHome: it would make /run/user
# read-only and the socket could not be created.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
